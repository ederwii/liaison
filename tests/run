#!/bin/bash
# Runs every check in the repo; prints PASS n / FAIL m; exit 1 on any failure.
cd "$(dirname "$0")/.." || exit 2
pass=0
fail=0

step() { # step <label> <command...>
  local label="$1"; shift
  echo "== $label"
  if "$@"; then
    pass=$((pass + 1))
  else
    echo "!! FAILED: $label"
    fail=$((fail + 1))
  fi
}

step "audit-leaks" scripts/audit-leaks.sh

if [ -f bridge/package.json ]; then
  step "bridge: bun test" bash -c 'cd bridge && bun test'
fi

for t in tests/*.test.sh; do
  [ -e "$t" ] || continue
  step "$t" /bin/bash "$t"
done

if ls tests/*_test.py >/dev/null 2>&1; then
  step "python unittest" python3 -m unittest discover -s tests -p '*_test.py'
fi

echo "PASS $pass / FAIL $fail"
[ "$fail" -eq 0 ]
