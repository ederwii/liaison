[Unit]
Description=liaison Slack bridge
After=network-online.target

[Service]
ExecStart="{BUN}" run "{BRIDGE_DIR}/src/index.ts"
WorkingDirectory={BRIDGE_DIR}
Environment=HOME={HOME}
Environment="PATH={PATH}:%h/.local/bin"
Environment=LIAISON_ROOT={LIAISON_HOME}
Restart=always
RestartSec=5
StandardOutput={LOG_TARGET}
StandardError={LOG_TARGET}

[Install]
WantedBy=default.target
